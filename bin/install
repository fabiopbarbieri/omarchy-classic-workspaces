#!/usr/bin/env bash
# One-time setup, with your consent: appends a marked block to the end of
# ~/.config/hypr/hyprland.lua and adds Setup > Workspaces to the Omarchy menu
# (both backed up first), and swaps in the bar widget. The mode stays as it is
# until you pick one: bin/mode classic | 4.5.
#
# Usage: install [--yes]
set -euo pipefail

confirm() {
  [[ ${1:-} == --yes || ${1:-} == -y ]] && return 0
  if [[ ! -t 0 ]]; then
    echo "Refusing to change your config without confirmation; run it in a terminal or pass --yes." >&2
    exit 1
  fi
  if command -v gum >/dev/null; then
    gum confirm "$PROMPT" || exit 0
  else
    read -r -p "$PROMPT [y/N] " answer
    [[ $answer == [yY]* ]] || exit 0
  fi
}
dir="$(cd "$(dirname "$0")/.." && pwd)"
id="$(jq -r .id "$dir/manifest.json")"
conf="$HOME/.config/hypr/hyprland.lua"
menu="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
stamp="$(date +%s)"

PROMPT="Classic Workspaces will add a marked block to the end of $conf and Setup > Workspaces entries to $menu (each backed up first), and replace the bar's workspace widget. Continue?"
confirm "${1:-}"

if ! grep -q "^-- BEGIN $id$" "$conf"; then
  cp "$conf" "$conf.bak.$stamp"
  cat >>"$conf" <<LUA
-- BEGIN $id
do
  local path = os.getenv("HOME") .. "/.config/omarchy/plugins/$id/hypr/classic-workspaces.lua"
  local file = io.open(path, "r")
  if file then file:close(); dofile(path) end
end
-- END $id
LUA
fi

if [[ ! -f $menu ]]; then
  mkdir -p "$(dirname "$menu")"
  printf '{\n}\n' >"$menu"
fi
# The checkmarks follow the mode Hyprland applied (bin/mode status), not the
# raw flag. An older install's entries are replaced.
mode="\$HOME/.config/omarchy/plugins/$id/bin/mode"
when="[[ -x $mode ]]"
entries="  // BEGIN $id
  \"setup.workspaces\": {\"icon\":\"󱂬\",\"label\":\"Workspaces\",\"when\":\"$when\"},
  \"setup.workspaces.classic\": {\"icon\":\"󰕰\",\"label\":\"Classic\",\"description\":\"One global set of workspaces 1-10\",\"when\":\"$when\",\"checked\":\"[[ \$($mode status) == classic ]]\",\"action\":\"$mode classic\"},
  \"setup.workspaces.per-monitor\": {\"icon\":\"󰍹\",\"label\":\"4.5 Workspaces\",\"description\":\"Each monitor has its own workspaces 1-10\",\"when\":\"$when\",\"checked\":\"[[ \$($mode status) == 4.5 ]]\",\"action\":\"$mode 4.5\"},
  // END $id"
current_entries="$(sed -n "/BEGIN ${id//./\\.}\$/,/END ${id//./\\.}\$/p" "$menu")"
if [[ $current_entries != "$entries" ]]; then
  cp "$menu" "$menu.bak.$stamp"
  sed -i "/BEGIN ${id//./\\.}\$/,/END ${id//./\\.}\$/d" "$menu"
  last=$(grep -n '^}' "$menu" | tail -1 | cut -d: -f1)
  { head -n $((last - 1)) "$menu"; printf '%s\n' "$entries"; tail -n +"$last" "$menu"; } >"$menu.tmp"
  mv "$menu.tmp" "$menu"
fi

hyprctl reload >/dev/null
hyprctl configerrors
omarchy-shell shell rescanPlugins >/dev/null
omarchy plugin enable "$id"
echo "Installed. Mode: $("$dir/bin/mode" status). Switch in Setup > Workspaces or with: $dir/bin/mode classic|4.5"
