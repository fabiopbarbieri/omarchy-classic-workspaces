#!/usr/bin/env bash
# Switch workspace mode: mode [classic|4.5|toggle|status]
#   classic  one global set 1-10, as in Omarchy 4.0.6
#   4.5      Omarchy 4.5's per-monitor workspaces
set -euo pipefail

flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/no-monitor-workspaces"
current=4.5
[[ -f $flag ]] && current=classic

case ${1:-toggle} in
  classic | 4.5) want=$1 ;;
  toggle) [[ $current == classic ]] && want=4.5 || want=classic ;;
  status) echo "$current"; exit 0 ;;
  *) echo "Usage: mode [classic|4.5|toggle|status]" >&2; exit 1 ;;
esac

[[ $want == "$current" ]] && exit 0

set_flag() {
  if [[ $1 == classic ]]; then
    mkdir -p "$(dirname "$flag")"
    touch "$flag"
  else
    rm -f "$flag"
  fi
}

# Switching modes moves workspaces between monitors, and Omarchy warps the
# cursor on workspace changes and focus. The marker tells the Lua part to turn
# warping off for this reload; afterwards the user's settings come back and the
# cursor goes back where it was, in case anything still moved it.
marker="${XDG_RUNTIME_DIR:-/tmp}/omarchy-classic-workspaces-switching"
warp_change="$(hyprctl getoption cursor:warp_on_change_workspace -j 2>/dev/null | jq -r '.int // 1')" || warp_change=1
no_warps="$(hyprctl getoption cursor:no_warps -j 2>/dev/null | jq -r 'if .bool then "true" else "false" end')" || no_warps=false
[[ $warp_change =~ ^[0-9]+$ ]] || warp_change=1
[[ $no_warps == true || $no_warps == false ]] || no_warps=false
read -r cursor_x cursor_y < <(hyprctl cursorpos 2>/dev/null | tr -d ',') || true

restore_cursor() {
  rm -f "$marker"
  hyprctl eval "hl.config({ cursor = { warp_on_change_workspace = $warp_change, no_warps = $no_warps } })" >/dev/null || true
  [[ $cursor_x =~ ^-?[0-9]+$ && $cursor_y =~ ^-?[0-9]+$ ]] || return 0
  hyprctl dispatch "hl.dsp.cursor.move({ x = $cursor_x, y = $cursor_y })" >/dev/null || true
}
trap 'rm -f "$marker"' EXIT
touch "$marker"

set_flag "$want"
if ! hyprctl reload >/dev/null; then
  set_flag "$current"
  echo "Could not reload Hyprland; workspace mode was not changed" >&2
  exit 1
fi

if [[ $want == classic ]]; then
  hyprctl eval 'if o.workspaces.compact then o.workspaces.compact() end' >/dev/null || true
fi
restore_cursor

if [[ $want == classic ]]; then
  omarchy-notification-send -g 󱂬 "Workspaces: Classic"
else
  omarchy-notification-send -g 󱂬 "Workspaces: 4.5 Workspaces"
fi
